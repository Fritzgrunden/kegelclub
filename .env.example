# ─────────────────────────────────────────────────────────────
# Kegelclub – Umgebungsvariablen
# Kopiere diese Datei nach `.env` und passe die Werte an.
# ─────────────────────────────────────────────────────────────

# Datenbank-Verbindung (PostgreSQL).
# Produktion / Supabase / Neon:
#   DATABASE_URL="postgres://user:passwort@host:5432/kegelclub?sslmode=require"
# Lokal ohne installiertes PostgreSQL (eingebettetes PostgreSQL via PGlite):
#   DATABASE_URL="pglite://./.data/kegelclub"
DATABASE_URL="pglite://./.data/kegelclub"

# Öffentliche Basis-URL der App (für Links in E-Mails, z. B. Passwort-Reset).
APP_URL="http://localhost:3000"

# Name des Vereins (Standardwert; kann im Admin-Bereich überschrieben werden).
CLUB_NAME="Kegelclub Alle Neune"

# E-Mail-Versand über Resend (https://resend.com). Optional.
# Ohne Konfiguration werden E-Mails in der Entwicklung nur in der Server-Konsole angezeigt.
RESEND_API_KEY=""
MAIL_FROM="Kegelclub <kegelclub@example.org>"

# Web-Push-Benachrichtigungen (neue Registrierungen für Admins, neue Strafen). Optional.
# Schlüsselpaar einmalig erzeugen mit: npx web-push generate-vapid-keys
# Der private Schlüssel bleibt geheim; ändert er sich, müssen alle Geräte Push neu aktivieren.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:vorstand@example.org"

# Nur für `npm run db:seed`: Passwort aller Demo-Konten (mind. 10 Zeichen).
SEED_DEMO_PASSWORD=""

# Nur für `npm run admin:create` (alternativ wird interaktiv gefragt).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
